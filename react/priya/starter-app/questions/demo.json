  "questions": [
    {
      "id": "html-1",
      "outcome": "H1",
      "prompt": "Which element should hold the main content of a page?",
      "choices": [
        {
          "id": "a",
          "text": "<div>"
        },
        {
          "id": "b",
          "text": "<main>"
        },
        {
          "id": "c",
          "text": "<section>"
        },
        {
          "id": "d",
          "text": "<body>"
        }
      ],
      "answer": "b",
      "explain": "<main> holds the main content. A page should have only one <main> that is not hidden.",
      "source": "https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/main"
    },
    {
      "id": "css-1",
      "outcome": "C1",
      "prompt": "Which selector picks every element with class=\"card\"?",
      "choices": [
        {
          "id": "a",
          "text": "#card"
        },
        {
          "id": "b",
          "text": "card"
        },
        {
          "id": "c",
          "text": ".card"
        },
        {
          "id": "d",
          "text": "*card"
        }
      ],
      "answer": "c",
      "explain": "A dot picks a class. A # picks an id, and a bare word picks a tag such as p.",
      "source": "https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Selectors/Class_selectors"
    },
    {
      "id": "js-3",
      "outcome": "J3",
      "prompt": "What does this give you?",
      "code": "[1, 2, 3].map((n) => n * 2)",
      "choices": [
        {
          "id": "a",
          "text": "[2, 4, 6]"
        },
        {
          "id": "b",
          "text": "12"
        },
        {
          "id": "c",
          "text": "[1, 2, 3, 2]"
        },
        {
          "id": "d",
          "text": "6"
        }
      ],
      "answer": "a",
      "explain": "map makes a new array from what the function returns for each item. React uses it to draw lists.",
      "source": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Array/map"
    }
  ]
}